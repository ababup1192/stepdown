      "default": "{enemy}を たおした"
    },
    "woke": {
      "kind": "field",
      "type": "text",
      "label": "敵が起きた",
      "order": 14,
      "group": "記録",
      "default": "{enemy}が 目をさました"
    },
    "approached": {
      "kind": "field",
      "type": "text",
      "label": "敵が隣に来た",
      "order": 15,
      "group": "記録",
