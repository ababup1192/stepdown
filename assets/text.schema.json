    "drank": {
      "kind": "field",
      "type": "text",
      "label": "薬を使った",
      "order": 18,
      "group": "記録",
      "default": "{item}を のんだ（+{n}）"
    },
    "descended": {
      "kind": "field",
      "type": "text",
      "label": "階段を降りた",
