{
  "//": "stepdown.text.json の形の宣言。{enemy}・{item}・{n} は差し込み。",
  "version": 1,
  "sections": {
    "title": {
      "kind": "field",
      "type": "text",
      "label": "題名",
      "order": 1,
      "group": "画面",
      "default": "ひとあし迷宮"
    },
    "startPrompt": {
      "kind": "field",
      "type": "text",
      "label": "はじめる案内",
      "order": 2,
      "group": "画面",
      "default": "タップか Enter で はじめる"
    },
    "dead": {
      "kind": "field",
      "type": "text",
      "label": "倒れた",
      "order": 3,
      "group": "画面",
      "default": "たおれてしまった…"
    },
    "cleared": {
      "kind": "field",
      "type": "text",
      "label": "抜けた",
      "order": 4,
      "group": "画面",
      "default": "1F を ぬけた！"
    },
    "retry": {
      "kind": "field",
      "type": "text",
      "label": "もう一度の案内",
      "order": 5,
      "group": "画面",
      "default": "タップか Enter で もう一度"
