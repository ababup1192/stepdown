# 長めの紹介動画の手順（make video FLOW=e2e/tour.flow）。周回の種は World.fixedSeed（地図は 1a）。
# 始まりの小部屋を一回り → ダッシュで通路へ → 起きたゼリーと通路の口で殴り合い → ダッシュで広間へ（敵が起きる）
# → 弓兵の矢 → コウモリを殴る → 爆弾を拾う（薬が効く）→ ゼリーと弓兵に囲まれて爆弾 → 鉄の剣・鉄の矢（枠が光る）
# → 鉄の矢でコウモリを撃つ → 広間を一回りして小さい地図を埋める → ダッシュで通路の角を曲がって小部屋を見に戻る → 階段で待って降りる → Clear。
start title
mark in_all
wait 1.5
tap confirm
wait 1.0
expect screen=Play&col=3&row=3
wait 0.5
# 始まりの小部屋を一回りして薬草を拾う（木の矢は拾わない）
tap left
wait 0.7
tap up
wait 0.7
expect col=2&row=2
tap up
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap right
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
expect col=4&row=2&walked=18
wait 0.4
# スワイプのダッシュ: 部屋から通路へ 1 歩、続けて通路を走り、ゼリーが起きた所で止まる
tap dashRight
until !busy max 3
wait 0.4
tap dashRight
until !busy max 3
expect col=7&row=2
wait 0.6
# ゼリーが寄ってくるのを待ち、通路の口で 3 回殴って倒す
tap wait
wait 0.7
tap wait
wait 0.7
tap wait
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
expect foes=3
wait 1.0
# 通路を下りて広間へ（入ると眠っていた敵が起きる）
tap right
wait 0.7
tap dashDown
until !busy max 3
expect col=8&row=5
wait 1.2
# 弓兵が列をそろえて矢を撃ってくる
tap down
wait 0.7
tap down
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
tap left
wait 0.7
expect col=4&row=8
# 道をふさぐコウモリを 1 回殴る（倒しきらずに残す）。弓兵の矢で HP が減り、薬草が効く
tap down
wait 0.7
tap right
wait 0.7
tap left
wait 0.7
expect hp=10
# 爆弾を拾う
tap down
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
expect col=3&row=10&bombs=2
wait 0.5
# ゼリーと弓兵に寄られたところで、2 体の隣に出て爆弾
tap down
wait 0.7
tap down
wait 0.7
tap right
wait 0.7
tap down
wait 0.7
tap up
wait 0.7
expect foes=1&bombs=1
wait 1.2
# 鉄の剣（上位）を拾う
tap down
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap up
wait 0.7
expect col=6&row=14
wait 1.0
# 鉄の矢を拾う（持ち物の枠が光る）
tap right
wait 0.7
tap right
wait 0.7
tap right
wait 0.7
tap down
wait 0.7
tap right
wait 0.7
tap down
wait 0.7
expect col=10&row=16&arrows=5
wait 1.3
# コウモリと列をそろえ、鉄の矢で撃ち落とす
tap left
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
expect col=8&row=11&foes=0&arrows=4
wait 1.3
# ダッシュで通路を上り、角を曲がって始まりの小部屋を見に戻る
tap up
wait 0.7
tap up
wait 0.7
tap dashUp
until !busy max 5
wait 0.4
expect col=8&row=4
tap dashUp
until !busy max 5
wait 0.4
expect col=5&row=2
wait 1.0
tap dashRight
until !busy max 5
wait 0.4
tap dashRight
until !busy max 5
wait 0.4
expect col=8&row=5
wait 0.8
# 広間を一回りして小さい地図を埋める: 右上の角
tap down
wait 0.7
tap down
wait 0.7
tap dashRight
until !busy max 5
wait 0.4
tap down
wait 0.7
tap right
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
tap left
wait 0.7
expect col=8&row=9
# まっすぐ下の端まで走る
tap dashDown
until !busy max 5
wait 0.4
expect col=8&row=19
wait 0.6
# 下の端から左下へ
tap left
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
tap dashLeft
until !busy max 5
wait 0.4
expect col=2&row=15
tap right
wait 0.7
tap up
wait 0.7
tap up
wait 0.7
tap left
wait 0.7
tap dashUp
until !busy max 5
wait 0.4
expect col=2&row=10
tap right
wait 0.7
tap up
wait 0.7
tap right
wait 0.7
tap down
wait 0.7
tap left
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
expect col=3&row=13
# 右の端まで走り、水場の右を見る
tap dashRight
until !busy max 5
wait 0.4
expect col=12&row=13
tap up
wait 0.7
tap up
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
tap down
wait 0.7
expect col=12&row=15
wait 0.8
# 階段へ歩き、上で待って降りる
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap left
wait 0.7
tap up
wait 0.7
expect col=5&row=14
wait 0.8
tap wait
until !busy max 3
expect screen=Clear
wait 2.5
mark out_all
